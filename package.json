{
  "name": "crm-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "npx only-allow bun",
    "build": "bunx turbo run build",
    "dev": "bunx turbo run dev --ui=tui",
    "start": "bunx turbo run start --ui=tui",
    "lint": "bunx turbo run lint",
    "format": "bunx prettier --write \"**/*.{ts,tsx,md}\""
  },
  "packageManager": "bun@1.3.14",
  "devDependencies": {
    "turbo": "latest",
    "prettier": "latest",
    "typescript": "latest",
    "eslint": "^10.4.0",
    "eslint-config-next": "latest",
    "eslint-config-prettier": "latest",
    "eslint-plugin-unicorn": "latest",
    "tailwindcss": "^4",
    "@tailwindcss/postcss": "^4"
  }
}
